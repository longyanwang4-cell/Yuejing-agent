# 复制为 backend/.env 后填写。.env 已在 .gitignore 里，不要提交。
# 任何 OpenAI 兼容接口都行：
#   DeepSeek   LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   通义千问    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
#   OpenAI     LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 路演现场网络不稳时设为 1，强制走离线规则（界面会标注离线演示模式）
FORCE_OFFLINE=0

# 公网部署必须保留限额。
# TRUST_PROXY：后端前面有反向代理（nginx 等）就设 1，否则所有人会被当成同一个来源 IP，限流一起触发。
# 直接对外监听、没有代理时必须保持 0：此时 X-Forwarded-For 是客户端自己写的，不能信。
DAILY_MODEL_CALL_CAP=1500
PER_IP_PER_HOUR=150
TRUST_PROXY=0
